generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DIRECTOR
  ASSISTANT
  ADMIN
}

enum AppointmentType {
  REUNION
  DEJEUNER
  VISITE
  VISIO
  PERSO
  AUTRE
}

enum AppointmentStatus {
  CONFIRMED
  PENDING
  CANCELLED
  DONE
}

enum Priority {
  HIGH
  NORMAL
  LOW
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  role          UserRole  @default(ASSISTANT)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdAppointments Appointment[] @relation("CreatedBy")
  directedAppointments Appointment[] @relation("Director")
  refreshTokens       RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Appointment {
  id          String            @id @default(uuid())
  title       String
  date        DateTime          @db.Date
  startTime   String            @map("start_time")
  endTime     String            @map("end_time")
  location    String?
  type        AppointmentType   @default(REUNION)
  status      AppointmentStatus @default(CONFIRMED)
  priority    Priority          @default(NORMAL)
  notes       String?           @db.Text
  createdById String            @map("created_by_id")
  directorId  String            @map("director_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  createdBy   User          @relation("CreatedBy", fields: [createdById], references: [id])
  director    User          @relation("Director", fields: [directorId], references: [id])
  participants Participant[]

  @@index([directorId, date])
  @@index([date])
  @@map("appointments")
}

model Participant {
  id            String  @id @default(uuid())
  appointmentId String  @map("appointment_id")
  name          String
  email         String?
  isExternal    Boolean @default(false) @map("is_external")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("participants")
}